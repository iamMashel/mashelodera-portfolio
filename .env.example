# Contact form (Resend). Copy to .env.local for local dev, and add the same
# vars in Vercel → Project → Settings → Environment Variables for production.

# Required to actually send mail. Get a free key at https://resend.com (API Keys).
RESEND_API_KEY=

# Where contact-form submissions are delivered. Defaults to the site email.
CONTACT_TO=mashelodera1@gmail.com

# The "From" address. Resend's shared sender works with no domain setup and can
# only deliver to your own Resend account email (fine to start). Once you verify
# a domain in Resend, switch to e.g. "Mashel Odera <hello@yourdomain.com>".
CONTACT_FROM=Mashel Odera Site <onboarding@resend.dev>
